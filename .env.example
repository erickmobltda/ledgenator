# Firebase web app "ledgenator" in the erickmob-apps project
# (firebase apps:sdkconfig WEB <appId> --project erickmob-apps)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=erickmob-apps.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=erickmob-apps
VITE_FIREBASE_APP_ID=

# erickmob-api: price refresh (market data keys live only on the server)
VITE_API_URL=https://api.erickmob.dev
